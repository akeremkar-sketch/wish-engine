{
  "format": 1,
  "scene": "scenes/main.scene.json",
  "seed": 1,
  "steps": [
    { "frames": 20 },
    { "input": { "move": [0, 1] }, "frames": 40 },
    { "input": { "move": [0, 1], "jump": true }, "frames": 1 },
    { "input": { "move": [0, 1] }, "frames": 45 },
    { "expect": "Game.crystals == 2", "message": "the first island: two crystals" },
    { "input": { "move": [0.7, 0.7] }, "frames": 10 },
    { "input": { "move": [0.7, 0.7], "jump": true }, "frames": 1 },
    { "input": { "move": [0.7, 0.7] }, "frames": 50 },
    { "expect": "Game.crystals >= 3 && Player.respawn.z == -10.5", "entity": "player", "message": "the second island: three crystals so far and its checkpoint" },
    { "until": "Time.elapsed >= 7.6", "max_frames": 600 },
    { "input": { "move": [0, 1] }, "frames": 12 },
    { "input": { "move": [0, 1], "jump": true }, "frames": 1 },
    { "input": { "move": [0, 1] }, "frames": 30 },
    { "until": "Time.elapsed >= 12.1", "max_frames": 600 },
    { "expect": "Transform.translation.z < -19.5 && CharacterState.grounded == true", "entity": "player", "message": "the lift carried the player across" },
    { "input": { "move": [0, 1] }, "frames": 6 },
    { "input": { "move": [0, 1], "jump": true }, "frames": 1 },
    { "input": { "move": [0, 1] }, "frames": 40 },
    { "expect": "Transform.translation.z < -23 && Transform.translation.y > 2.8", "entity": "player", "message": "a jump from the lift lands on the goal island" },
    { "input": { "move": [-0.85, 0.53] }, "until": "Game.crystals >= 5", "max_frames": 120 },
    { "input": { "move": [1, -0.24] }, "until": "Game.crystals >= 6", "max_frames": 120 },
    { "expect": "Game.won == false", "message": "the goal is still ahead" },
    { "input": { "move": [-0.45, 0.9] }, "until": "Game.won == true", "max_frames": 120 },
    { "expect": "Game.crystals == 6 && Game.falls == 0", "message": "every crystal, no fall" },
    { "frames": 30 },
    { "expect": "UiNode.visible == true", "entity": "win_panel", "message": "the win screen is shown" },
    { "capture": { "golden": "tests/golden/win.png", "width": 320, "height": 180 } }
  ]
}
