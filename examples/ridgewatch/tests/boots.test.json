{
  "format": 1,
  "scene": "scenes/main.scene.json",
  "seed": 1,
  "steps": [
    { "frames": 60 },
    { "expect": "has(Camera)", "message": "the scene has a camera to look through" },
    { "expect": "Station.phase == 'Playing' && Station.repairs_needed == 5", "message": "alone, the game is a practice round" },
    { "expect": "Avatar.present == true && Transform.translation.y > 18.5", "entity": "keeper_0", "message": "the one keeper stands at the bell" },
    { "input": { "move": [0, -1] }, "until": "Avatar.player == 0 && Transform.translation.y < 16.3", "max_frames": 120 },
    { "input": { "move": [-1, 0] }, "until": "Avatar.player == 0 && Transform.translation.x < 13", "max_frames": 300 },
    { "expect": "Door.open == true && Occluder.enabled == false", "entity": "door_west", "message": "the west door slid open for the keeper" },
    { "expect": "UiText.text == \"You are a keeper. Hold E at a machine to repair it.\"", "entity": "hud_role" }
  ]
}
